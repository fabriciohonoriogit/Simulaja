# =================================================================
# CONTEMPLAR CRM / SIMULAJA - MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =================================================================

# 1. Supabase (Banco de Dados & Autenticação)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-supabase

# 2. Make.com Webhooks (Esteiras de Automação & WhatsApp)
VITE_MAKE_WEBHOOK_LEADS=https://hook.us2.make.com/exemplo_leads
VITE_MAKE_WEBHOOK_AGENDAMENTO=https://hook.us2.make.com/exemplo_agendamentos
VITE_MAKE_WEBHOOK_WHATSAPP=https://hook.us2.make.com/exemplo_whatsapp
VITE_MAKE_WEBHOOK_VENDA=https://hook.us2.make.com/exemplo_vendas

# 3. Evolution API (Servidor WhatsApp Headless)
VITE_EVOLUTION_API_URL=https://sua-evolution-api.com
VITE_EVOLUTION_API_KEY=sua-chave-global-evolution
VITE_EVOLUTION_INSTANCE_NAME=simulaja

# 4. Inteligência Artificial (Google Gemini API & Jarvis)
VITE_GEMINI_API_KEY=sua-chave-gemini-aqui
